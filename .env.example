# Supabase (public — safe for browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional: NAD → EUR display rate (catalog stays NAD). Default 0.05 (N$20 = €1).
# NEXT_PUBLIC_EUR_PER_NAD=0.05
# Alias: NEXT_PUBLIC_NAD_TO_EUR=0.05

# Optional: local product images base for admin previews
# NEXT_PUBLIC_SITE_URL=http://127.0.0.1:43123
